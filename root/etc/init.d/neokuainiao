#!/bin/sh /etc/rc.common
# NeoKuaiNiao 服务托管：procd 常驻 kpn.sh daemon
START=99
STOP=10
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/libexec/neokuainiao/kpn.sh daemon
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	# 停止时主动恢复带宽，避免用户取消订阅后还占着提速额度
	/usr/libexec/neokuainiao/kpn.sh down >/dev/null 2>&1
	# 顺手清掉未完成的登录会话（里面有内存型临时密码）
	/usr/libexec/neokuainiao/kpn.sh login-cancel >/dev/null 2>&1
}

service_triggers() {
	procd_add_reload_trigger "neokuainiao"
}
